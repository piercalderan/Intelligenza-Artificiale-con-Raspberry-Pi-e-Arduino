    {
        "id": "bb1d67d8ca2797ad",
        "type": "ui_template",
        "z": "0fe2d26d898f1254",
        "group": "85f5f51f0d526f74",
        "name": "Dark Theme – AI Style",
        "order": 22,
        "width": 0,
        "height": 0,
        "format": "<style>\n  .md-card,\n  .nr-dashboard-cardpanel,\n  .nr-dashboard-template {\n    background-color: #5b6782 !important;\n    color: #eaf4ff !important;\n  }\n\n  .nr-dashboard-gauge text {\n    fill: #eaf4ff !important;\n  }\n</style>\n<style id=\"ai-dark-theme\">\n:root{\n  --bg:#0f1e2c;\n  \n  --card:#132434; \n  --text:#eaf4ff; \n  --muted:#a7c0d8; \n  --line:#2b3a4a; \n  --accent:#eaf4ff; \n  --accent-2:#2b88d8;\n}\n/* canvas generale */\nbody.nr-dashboard-theme, md-content, .nr-dashboard-template, .nrdb-body, .nr-dashboard-theme md-content._md{ background:var(--bg) !important; }\n\n/* 🔹 Testi dei valori nei gauge */\n.nr-dashboard-theme .nr-dashboard-gauge .nr-dashboard-gauge-value text,\n.nr-dashboard-theme .nr-dashboard-gauge text {\nfill: #eaf4ff !important; /* testo chiaro */\n}\n\n/* 🔹 Colore sfondo gruppi e card */\n.nr-dashboard-theme .card,\n.nr-dashboard-theme .group,\n.md-card,\n.vuetify-styles .v-card {\nbackground-color: #0f172a !important; /* blu scuro */\nborder-radius: 10px !important;\nborder: 1px solid #1e293b !important;\n}\n\n\n/* card / panel */\nmd-card, .nr-dashboard-widget, .nr-dashboard-template .nr-dashboard-cardpanel{\nbackground:var(--card) !important; color:var(--text) !important;\nborder-radius:14px !important; box-shadow:0 6px 24px rgba(0,0,0,.25) !important;\n}\n/* titoli card */\nmd-card md-toolbar, .nr-dashboard-cardtitle{ background:transparent !important; color:var(--accent) !important; border-bottom:1px solid transparent !important; }\n\n/* testo generico */\n.nr-dashboard-text, .nr-dashboard-template, .nr-dashboard-template *{ color:var(--text) !important; }\n\n/* input & textarea */\nmd-input-container .md-input, .nr-dashboard-textinput input, .nr-dashboard-template textarea, textarea.md-input{\n  background:#0f1e2c !important; color:var(--text) !important; border:1px solid var(--line) !important;\n  border-radius:10px !important; padding:8px 10px !important;\n}\n/* placeholder */\nmd-input-container .md-input::placeholder, .nr-dashboard-textinput input::placeholder, textarea::placeholder{ color:var(--muted) !important; }\n\n/* dropdown */\nmd-select, md-select-value, .md-select-value .md-text{ color:var(--text) !important; }\nmd-select{ border:1px solid var(--line) !important; border-radius:10px !important; background:#0f1e2c !important; padding:6px 8px !important; }\n\n/* bottoni */\nmd-button, .nr-dashboard-button .md-button{\n  background:var(--accent) !important; \n  color:#00223d !important;   \n  border-radius:10px !important;\n  font-weight:600 !important;\n\n}\nmd-button.md-raised:not([disabled]):hover{ filter:brightness(1.06); }\nmd-button[disabled]{ opacity:.5 !important; }\n\n/* switch/slider */\nmd-switch .md-bar{ background:var(--line) !important; }\nmd-switch.md-checked .md-bar{ background:linear-gradient(90deg, var(--accent), var(--accent-2)) !important; }\nmd-switch .md-thumb{ background:#a6d3f5 !important; border:1px solid var(--line) !important; }\nmd-switch.md-checked .md-thumb{ background:#f5f5a6 !important; border-color:transparent !important; }\n\n/* tabelle e liste */\nmd-list-item, md-list{ background:transparent !important; color:var(--text) !important; }\n\n/* debug panel (se mostrato in ui_template) */\npre, code{ \nbackground:#4e6478 !important; \nborder:1px solid var(--line); \ncolor:var(--text); \nborder-radius:8px; \npadding:8px; }\n\n/* separatori leggeri */\nmd-divider, .nr-dashboard-template hr{ border-color:var(--line) !important; }\n\n/* link */\na, a:visited{ color:var(--accent) !important; }\na:hover{ color:var(--muted) !important; }\n\n/* spacing uniforme dentro i widget */\n.nr-dashboard-template .pad, .nr-dashboard-text input, .nr-dashboard-template input, .nr-dashboard-template textarea{ box-sizing:border-box; }\n\n/* ripulisci ombre/material residue */\nmd-card ._md, ._md{ box-shadow:none !important; }\n</style>\n<script>\n// opzionale: piccola \"firma\" in console per ricordare che il tema è attivo\nconsole.log('%cAI Dark Theme loaded','background:#5bb1ff;color:#001a2d;padding:2px 6px;border-radius:6px');\n</script>\n",
        "storeOutMessages": false,
        "fwdInMessages": false,
        "resendOnRefresh": true,
        "templateScope": "local",
