    {
        "id": "9a7423c063a330b4",
        "type": "function",
        "z": "0fe2d26d898f1254",
        "name": "Base64 → MP3",
        "func": "// Prende la base64 da più varianti di campo\nlet s =\n    (msg.payload && (msg.payload.audio_b64 || msg.payload[\"audio/b64\"])) ||\n    msg.audio_b64 || msg[\"audio/b64\"] ||\n    ((typeof msg.payload === \"string\") ? msg.payload : null);\n\nif (typeof s !== \"string\") {\n    node.error(\"Nessuna stringa base64 trovata in payload\");\n    return null;\n}\n\n// Pulisci prefissi e whitespace\ns = s.trim()\n     .replace(/^data:audio\\/[a-zA-Z0-9+.\\-]+;base64,/, \"\")\n     .replace(/\\s+/g, \"\");\n\n// Normalizza URL-safe → base64 standard\ns = s.replace(/-/g, \"+\").replace(/_/g, \"/\");\n\n// Padding (=)\nconst pad = s.length % 4;\nif (pad) s += \"=\".repeat(4 - pad);\n\n// IMPORTANTISSIMO: lasciare STRINGA base64 nel payload\nmsg.payload  = s;\nmsg.filename = \"C:/Users/pier/Desktop/0_LIBRO_AI/voice_reply.mp3\";\nreturn msg;\n\n\n\n/*\n// accetta {audio_b64:\"...\"} o msg.payload stringa\nlet s = msg.payload?.audio_b64 || msg.audio_b64 || msg.payload;\nif (typeof s !== \"string\") {\n    node.error(\"audio_b64 mancante\"); return null;\n}\n\n// rimuovi eventuale header data: e whitespace\ns = s.trim()\n     .replace(/^data:audio\\/[a-zA-Z0-9+.\\-]+;base64,/, \"\")\n     .replace(/\\s+/g, \"\");\n\n// normalizza url-safe\ns = s.replace(/-/g, \"+\").replace(/_/g, \"/\");\n\n// padding\nconst pad = s.length % 4;\nif (pad) s += \"=\".repeat(4 - pad);\n\n// lasciare STRINGA base64 nel payload (N O N creare Buffer!)\nmsg.payload = s;\n// percorso file: usa forward slash su Windows, è ok\nmsg.filename = \"C:/Users/pier/Desktop/0_LIBRO_AI/voice_reply.mp3\";\nreturn msg;\n\n/*\nlet b64 = msg.payload?.audio_b64 || msg.audio_b64 || msg.payload;\nif (typeof b64 !== \"string\") {\n    node.error(\"Nessun campo audio_b64 nel payload\");\n    return null;\n}\n\n// rimuovi spazi, ritorni e intestazioni data:\nb64 = b64.trim()\n         .replace(/^data:audio\\/[a-zA-Z0-9+.-]+;base64,/, \"\")\n         .replace(/\\s+/g, \"\")\n         .replace(/-/g, \"+\")\n         .replace(/_/g, \"/\");\n\n// padding\nconst pad = b64.length % 4;\nif (pad) b64 += \"=\".repeat(4 - pad);\n\nlet buf;\ntry {\n    buf = Buffer.from(b64, \"base64\");\n} catch (e) {\n    node.error(\"Errore decoding base64: \" + e);\n    return null;\n}\n\n// check header MP3\nconst sig = buf.slice(0, 3).toString(\"ascii\");\nif (sig !== \"ID3\" && !(buf[0] === 0xff && (buf[1] & 0xe0) === 0xe0)) {\n    node.warn(\"Attenzione: header MP3 non riconosciuto \" + buf.slice(0, 8).toString(\"hex\"));\n}\n\nmsg.payload  = buf;\nmsg.filename = \"C:/Users/pier/Desktop/0_LIBRO_AI/voice_reply.mp3\";\nreturn msg;\n*/",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
