        "name": "Base64 → Buffer + save path",
        "func": "const p = msg.payload || {};\nif (!p.audio_b64) { node.warn('audio_b64 mancante'); return null; }\nconst b = Buffer.from(p.audio_b64, 'base64');\nmsg.payload = b;\n// Percorso file su Windows (cambia se serve)\nmsg.filename = \"C:\\\\Users\\\\pier\\\\Desktop\\\\0_LIBRO_AI\\\\tts_out.mp3\";\n// memorizza l'ultimo file per il pulsante Play\nflow.set('last_mp3', msg.filename);\nreturn msg;",
