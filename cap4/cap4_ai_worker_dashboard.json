    {
        "id": "8a6826a87a5bd1d4",
        "type": "function",
        "z": "f1bd58fb95353d3e",
        "name": "→ textarea + store latest",
        "func": "// p può essere {id, text} o {reply} a seconda del worker\nconst p   = msg.payload || {};\nconst txt = (p.text || p.reply || p.message || \"\").toString().trim();\nif (!txt) return null;\n\n// 1) Output #1 → aggiorna textarea\nconst out1 = { payload: txt };\n\n// 2) Se auto_speak è ON → prepara richiesta TTS\nconst auto = !!flow.get('auto_speak');\nlet out2 = null;\nif (auto) {\n  const voice = (flow.get('voice') || 'alloy');\n  out2 = {\n    topic: 'ai/requests/tts',\n    payload: {\n      id: 'v_' + Date.now(),\n      text: txt,\n      voice\n    }\n  };\n}\n\n// memorizza per eventuale uso manuale\nflow.set('last_reply', txt);\n\nreturn [out1, out2];\n",
        "outputs": 2,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
