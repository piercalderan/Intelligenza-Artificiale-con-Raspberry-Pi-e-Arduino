    {
        "id": "9822182b656a87d9",
        "type": "function",
        "z": "f1bd58fb95353d3e",
        "name": "Prep → VLC cmd",
        "func": "// Prende un percorso valido da msg.filename, msg.payload o flow.last_mp3\nlet file = msg.filename || msg.payload || flow.get('last_mp3') || \"\";\n\n// Scarta payload “1” o valori non stringa\nif (typeof file !== \"string\") file = String(file || \"\");\nif (file.trim() === \"\" || file.trim() === \"1\") return null;\n\n// Se vuoi essere ultra-sicuro che il file esista, decommenta:\n// const fs = require('fs');\n// if (!fs.existsSync(file)) { node.warn(\"File non trovato: \" + file); return null; }\n\n// VLC è nel PATH\nmsg.vlc_cmd = \"vlc --intf dummy --play-and-exit\";\n\n// Metti il percorso tra virgolette e scappa eventuali virgolette interne\nmsg.payload = '\"' + file.replace(/\"/g, '\"\"') + '\"';\n\nreturn msg;\n",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
