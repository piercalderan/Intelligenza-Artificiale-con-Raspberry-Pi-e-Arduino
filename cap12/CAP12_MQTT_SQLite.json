    {
        "id": "fn_gate_clear",
        "type": "function",
        "z": "tab_cap12_full",
        "name": "Se confermato → DELETE",
        "func": "// Se flow.confirm_clear è true → esegue DELETE e refresh\nconst ok = flow.get('confirm_clear') === true;\nif (!ok) {\n  // Avvisa utente\n  return [null, {payload: \"Per azzerare attiva il toggle 'Conferma azzera'\"}];\n}\n// Due messaggi: DELETE e poi SELECT refresh\nlet msg1 = { topic: \"DELETE FROM events;\" };\nlet msg2 = { topic: \"SELECT id, ts, type, data FROM events ORDER BY id DESC LIMIT 50;\" };\nreturn [[msg1, msg2], null];",
        "outputs": 2,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
