    {
        "id": "fn_rows_to_csv",
        "type": "function",
        "z": "tab_cap12_full",
        "name": "Rows → CSV",
        "func": "// Converte array di righe SQLite in CSV (header incluso)\n// File: /home/pi/nodered_data/exports/events_YYYYMMDD_HHMMSS.csv\n\nfunction pad(n){ return n<10?('0'+n):(''+n); }\nconst now = new Date();\nconst ts = now.getFullYear().toString() + pad(now.getMonth()+1) + pad(now.getDate()) + \"_\" + pad(now.getHours()) + pad(now.getMinutes()) + pad(now.getSeconds());\nconst outdir = \"/home/pi/nodered_data/exports\";\nconst fname = `${outdir}/events_${ts}.csv`;\n\nconst rows = Array.isArray(msg.payload) ? msg.payload : [];\nconst header = [\"id\",\"ts\",\"type\",\"data\"];\n\n// CSV escaping\nfunction esc(v){\n  if (v === null || v === undefined) return \"\";\n  v = String(v);\n  if (v.includes('\"') || v.includes(',') || v.includes('\\n')){\n    v = '\"' + v.replace(/\"/g,'\"\"') + '\"';\n  }\n  return v;\n}\n\nlet lines = [header.join(\",\")];\nfor (const r of rows){\n  const line = [esc(r.id), esc(r.ts), esc(r.type), esc(r.data)].join(\",\");\n  lines.push(line);\n}\n\nmsg.filename = fname;\nmsg.payload = lines.join(\"\\n\") + \"\\n\";\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 630,
        "y": 460,
        "wires": [
            [
                "file_write_csv",
                "ui_toast_saved"
            ]
        ]
    },
