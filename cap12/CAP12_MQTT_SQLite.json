        "type": "function",
        "z": "tab_cap12_full",
        "name": "Build SELECT con filtro",
        "func": "let f = flow.get('filter_type') || 'all';\nlet base = \"SELECT id, ts, type, data FROM events\";\nlet where = \"\";\nif (f === 'face') where = \" WHERE type='face'\";\nif (f === 'motion_burst') where = \" WHERE type='motion_burst'\";\nmsg.topic = base + where + \" ORDER BY id DESC LIMIT 50;\";\nreturn msg;",
