    {
        "id": "fn_build_insert_from_mqtt",
        "type": "function",
        "z": "tab_cap12_full",
        "name": "Build INSERT (prepared → msg.params)",
        "func": "// Accetta payload dal Python: {id, ts, type, data}\n// ts: preferisce quello ricevuto, fallback: ISO now\nconst p = msg.payload || {};\nconst ts   = String(p.ts || new Date().toISOString());\nconst type = String(p.type || \"?\");\nconst data = (typeof p.data === 'string') ? p.data : JSON.stringify(p.data || {});\n\nmsg.params = [ ts, type, data ];\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 660,
        "y": 120,
